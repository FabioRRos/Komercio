CREATE FUNCTION public.trg_controla_status_produto() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Se estoque zerou → desativa produto
    IF NEW.quantidade = 0 THEN
        UPDATE product
        SET status = FALSE
        WHERE codigobarras = NEW.codigobarras;

    -- Se voltou a ter estoque → reativa produto
    ELSIF NEW.quantidade > 0 THEN
        UPDATE product
        SET status = TRUE
        WHERE codigobarras = NEW.codigobarras;
    END IF;

    RETURN NEW;
END;
$$;


