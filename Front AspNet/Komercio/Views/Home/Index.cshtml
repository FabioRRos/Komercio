@using Komercio.Models.ViewModels
@model DashboardFinanceiroViewModel

@{
    ViewData["Title"] = "Dashboard Financeiro";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <h2 class="h3 mb-0 text-gray-800">Movimentação Financeira </h2>
        <h3 class="h6" mb-0 text gray-800> Caixa do dia @Model.DataAtual.ToString("dd/MM/yyyy")</h3>

        <div class="d-flex flex-wrap align-items-center gap-3">

            <div class="d-flex align-items-center border rounded px-3 py-2 bg-white shadow-sm">
                <span class="me-2 fw-bold text-secondary">Status:</span>
                @if (Model.CaixaAberto)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i> ABERTO
                    </span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1 rounded-pill">
                        <i class="bi bi-lock-fill me-1"></i> FECHADO
                    </span>
                }
            </div>

           
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-9">

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row text-center">
                        <div class="col-md-3 border-end">
                            <h3 class="h6" mb-0 text gray-800>Saldo Inicial</h3>
                            <small class="text-muted d-block mb-1">(Abertura)</small>
                            <h3 class="fw-bold text-dark">@Model.SaldoInicial.ToString("C2")</h3>
                        </div>
                        <div class="col-md-3 border-end">
                            <h3 class="h6" mb-0 text gray-800>Valor em vendas</h3>
                            <small class="text-muted d-block mb-1">(Todas as formas de pagamento)</small>
                            <h3 class="fw-bold text-dark">@Model.TotalEntradas.ToString("C2")</h3>
                        </div>
                        <div class="col-md-3 border-end">
                            <h3 class="h6" mb-0 text gray-800>
                                Dinheiro em caixa</h3>
                            <small class="text-muted d-block mb-1">(Abertura + venda em dinheiro)</small>

                            <h3 class="fw-bold text-dark">@Model.TotalSaidas.ToString("C2")</h3>
                        </div>
                        
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Histórico de Movimentações</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer me-1"></i> Imprimir</button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Hora</th>
                                    <th>Tipo</th>
                                    <th>Descrição</th>
                                    <th>Forma Pagto</th>
                                    <th class="text-end pe-4">Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.HistoricoMovimentacoes.Any())
                                {
                                    @foreach (var item in Model.HistoricoMovimentacoes)
                                    {
                                        bool isEntrada = item.MovementType.ToLower() == "entrada";
                                        string badgeClass = isEntrada ? "bg-success" : "bg-danger";
                                        string textClass = isEntrada ? "text-success" : "text-danger";
                                        string sinal = isEntrada ? "+" : "-";

                                        <tr>
                                            <td class="ps-4 text-muted">@item.movementDatetime.ToString("HH:mm")</td>
                                            <td>
                                                <span class="badge @badgeClass bg-opacity-25 @textClass px-3 rounded-pill">
                                                    @item.MovementType
                                                </span>
                                            </td>
                                            <td>
                                                @if (string.IsNullOrEmpty(item.Description))
                                                {
                                                    <span class="text-muted fst-italic">Sem descrição</span>
                                                }
                                                else
                                                {
                                                    @item.Description
                                                }
                                                @if (item.saleId > 0)
                                                {
                                                    <small class="text-muted ms-1">(Venda #@item.saleId)</small>
                                                }
                                            </td>
                                            <td>@item.PaymentMethod</td>
                                            <td class="text-end pe-4 fw-bold @textClass">
                                                @sinal @item.amount.ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            Nenhuma movimentação registrada hoje.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">Resumo por Forma de Pagamento</h6>
                </div>
                <div class="card-body">
                    @if (Model.ResumoPorFormaPagamento.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var resumo in Model.ResumoPorFormaPagamento)
                            {
                                // Define ícones baseados no nome
                                string icon = "bi-cash";
                                if (resumo.Forma.ToLower().Contains("pix")) icon = "bi-ui-checks-grid"; // Ícone estilo PIX
                                else if (resumo.Forma.ToLower().Contains("crédito")) icon = "bi-credit-card-2-front";
                                else if (resumo.Forma.ToLower().Contains("débito")) icon = "bi-credit-card";

                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light p-2 me-3 text-primary">
                                            <i class="bi @icon fs-5"></i>
                                        </div>
                                        <span>@resumo.Forma</span>
                                    </div>
                                    <span class="fw-bold">@resumo.Valor.ToString("C2")</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-wallet2 fs-1 d-block mb-2"></i>
                            Sem entradas hoje.
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>