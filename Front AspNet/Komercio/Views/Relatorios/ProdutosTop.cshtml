@using Komercio.Models.ViewModels
@model List<TopProdutosViewModel>

@{
    ViewData["Title"] = "Produtos Mais Vendidos";

    // Recupera o valor que mandamos pelo Controller via ViewBag
    // Se por acaso vier nulo (não deveria), assume 30 para não quebrar a tela
    int diasAtuais = ViewBag.DiasFiltro ?? 30;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-graph-up-arrow me-2"></i>Produtos Mais Vendidos</h2>
            <p class="text-muted">
                Mostrando os dados dos últimos <strong>@diasAtuais dias</strong>.
            </p>
        </div>

        <div class="btn-group shadow-sm">
            <a href="/Relatorios/ProdutosTop?dias=7"
               class="btn btn-outline-primary @(diasAtuais == 7 ? "active" : "")">
                7 Dias
            </a>
            <a href="/Relatorios/ProdutosTop?dias=15"
               class="btn btn-outline-primary @(diasAtuais == 15 ? "active" : "")">
                15 Dias
            </a>
            <a href="/Relatorios/ProdutosTop?dias=30"
               class="btn btn-outline-primary @(diasAtuais == 30 ? "active" : "")">
                30 Dias
            </a>
            <a href="/Relatorios/ProdutosTop?dias=90"
               class="btn btn-outline-primary @(diasAtuais == 90 ? "active" : "")">
                90 Dias
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="text-center" style="width: 80px;">#</th>
                            <th>Produto</th>
                            <th class="text-center">Qtd. Vendida</th>
                            <th class="text-end pe-4">Valor Total Gerado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            // Variável contador para mostrar o Rank (1º, 2º, 3º...)
                            int posicao = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-secondary">
                                        @posicao °
                                    </td>

                                    <td class="fw-bold">
                                        @item.ProductName
                                        <br />
                                        <small class="text-muted" style="font-size: 0.8em">ID: @item.ProductId</small>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border fs-6">
                                            @item.QuantidadeTotal
                                        </span>
                                    </td>

                                    <td class="text-end pe-4 text-success fw-bold">
                                        @item.ValorTotal.ToString("C2")
                                    </td>
                                </tr>

                                // Incrementa a posição para a próxima linha
                                posicao = posicao + 1;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                    Nenhum produto vendido neste período de @diasAtuais dias.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>