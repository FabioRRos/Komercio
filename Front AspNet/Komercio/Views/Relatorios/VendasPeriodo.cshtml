@model Komercio.Models.ViewModels.RelatorioVendasViewModel

@{
    ViewData["Title"] = "Relatório de Vendas por Período";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-0 text-dark fw-bold">
                <i class="bi bi-calendar3 me-2 text-primary"></i>Relatório de Vendas
            </h2>
            <small class="text-muted">Consulte o desempenho de vendas por data e vendedor</small>
        </div>
        <a asp-action="Index" asp-controller="Relatorios" class="btn btn-outline-secondary shadow-sm px-3">
            <i class="bi bi-arrow-left-circle me-2"></i>Voltar
        </a>
    </div>

    <div class="card bg-light mb-4 shadow-sm border-0">
        <div class="card-body">
            <form asp-action="VendasPeriodo" method="get">
                <div class="row align-items-end">
                    <div class="col-md-5">
                        <div class="row">
                            <div class="col-6">
                                <label class="form-label fw-bold text-secondary small">DATA INICIAL</label>
                                <input asp-for="DataInicial" type="date" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-secondary small">DATA FINAL</label>
                                <input asp-for="DataFinal" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary px-4 me-2 shadow-sm">
                                <i class="bi bi-search me-1"></i> FILTRAR
                            </button>
                            <a asp-action="VendasPeriodo" class="btn btn-secondary px-4">
                                <i class="bi bi-eraser me-1"></i> LIMPAR
                            </a>
                        </div>
                    </div>

                    <div class="col-md-3 text-center border-start border-end">
                        <h6 class="text-muted small fw-bold">TOTAL VENDIDO NO PERÍODO</h6>
                        <div class="display-6 fw-bold text-success bg-white border rounded p-2 mb-2 shadow-sm">
                            @Model.TotalVendido.ToString("C2")
                        </div>
                        <span class="fs-5 text-muted">Vendas: <strong>@Model.TotalQuantidade</strong></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small">VENDEDOR</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <select asp-for="VendedorSelecionado"
                                    asp-items="Model.ListaVendedores"
                                    class="form-select shadow-none">
                                <option value="">Todos os vendedores</option>
                            </select>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Cliente</th>
                            <th>CPF/CNPJ</th>
                            <th>Vendedor</th>
                            <th>Valor Venda</th>
                            <th>Desconto</th>
                            <th>Valor Final</th>
                            <th>Data Venda</th>
                            <th>Forma Pagto</th>
                            <th class="text-center pe-3">Detalhes da Venda</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Vendas != null && Model.Vendas.Any())
                        {
                            @foreach (var item in Model.Vendas)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@item.SaleId</td>
                                    <td>@item.CustomerName</td>
                                    <td class="text-muted small">@item.CustomerDocument</td>
                                    <td>@item.SellerName</td>
                                    <td>@item.TotalAmount.ToString("C2")</td>
                                    <td class="text-danger">- @item.DiscountAmount.ToString("C2")</td>
                                    <td class="fw-bold text-success">@item.FinalAmount.ToString("C2")</td>
                                    <td>
                                        @item.SaleDate.ToString("dd/MM/yyyy")
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">
                                            <i class="bi bi-clock me-1"></i>@(item.SaleTime.Length >= 5 ? item.SaleTime.Substring(0, 5) : item.SaleTime)
                                        </small>
                                    </td>
                                    <td><span class="badge rounded-pill bg-secondary px-3">@item.PaymentMethod</span></td>

                                    <td class="text-center pe-3">
                                        <button class="btn btn-sm btn-primary shadow-sm px-3 d-inline-flex align-items-center"
                                                onclick="CarregarItens(@item.SaleId)">
                                            <i class="bi bi-info-circle me-2"></i> DETALHES
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>
                                    Nenhuma venda encontrada para os filtros selecionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalItens" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-list-check me-2"></i>Itens da Venda</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="conteudoDoModal">
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function CarregarItens(idVenda) {
            var modalElement = document.getElementById('modalItens');
            var meuModal = new bootstrap.Modal(modalElement);
            meuModal.show();

            var divConteudo = document.getElementById('conteudoDoModal');
            divConteudo.innerHTML = `
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                    <p class="mt-3 text-muted fw-bold">Buscando itens da venda #${idVenda}...</p>
                </div>`;

            fetch(`/Relatorios/ItensDaVenda?saleId=${idVenda}`)
                .then(resposta => {
                    if (!resposta.ok) throw new Error('Erro ao carregar os dados do servidor.');
                    return resposta.text();
                })
                .then(html => {
                    divConteudo.innerHTML = html;
                })
                .catch(erro => {
                    divConteudo.innerHTML = `
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>Erro ao carregar itens. Verifique sua conexão ou tente novamente.</div>
                        </div>`;
                    console.error(erro);
                });
        }
    </script>
}