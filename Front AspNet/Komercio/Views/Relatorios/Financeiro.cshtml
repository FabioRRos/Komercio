@{
    ViewData["Title"] = "Movimentações Financeiras";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 75vh;">
    <div class="text-center">
        <div class="display-1 text-success mb-4">
            <i class="bi @Model?.IconClass ?? " bi-cash-coin" d-inline-block shadow-sm rounded-circle p-4 bg-white"
               style="animation: pulse-animation 2s infinite;"></i>
        </div>

        <h1 class="fw-bold text-dark">Movimentações Financeiras</h1>
        <p class="fs-5 text-muted">Estamos preparando o módulo de fluxo de caixa e balanço para você.</p>

        <div class="mt-4 d-flex justify-content-center gap-2">
            <span class="badge rounded-pill bg-primary px-3 py-2">
                <i class="bi bi-code-slash me-1"></i> Em Desenvolvimento
            </span>
            <span class="badge rounded-pill bg-dark px-3 py-2">
                <i class="bi bi-cone-striped me-1"></i> Breve
            </span>
        </div>

        <div class="mt-5">
            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i> Voltar
            </a>
        </div>
    </div>
</div>

<style>
    @@keyframes pulse-animation {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.05);
            opacity: 0.8;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>