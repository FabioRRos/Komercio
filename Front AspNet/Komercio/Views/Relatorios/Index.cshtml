@using Komercio.Models.ViewModels
@model List<ReportMenuOption>

@{
    ViewData["Title"] = "Relatórios Gerenciais";
}

<div class="container mt-4">
    <h2 class="mb-4 text-secondary">@ViewData["Title"]</h2>

    <div class="row g-3">
        @foreach (var btn in Model)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <a asp-controller="@btn.ControllerName"
                   asp-action="@btn.ActionName"
                   class="card report-tile h-100 shadow-sm text-decoration-none">

                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                        <i class="bi @btn.IconClass display-4 mb-3"></i>

                        <h5 class="card-title text-uppercase fw-bold">@btn.Title</h5>
                    </div>
                </a>
            </div>
        }
    </div>
</div>