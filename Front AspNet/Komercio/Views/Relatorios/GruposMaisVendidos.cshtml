@using Komercio.Models.ViewModels
@model List<GruposTopViewModel>

@{
    ViewData["Title"] = "Grupos Mais Vendidos";
    int diasAtuais = ViewBag.DiasFiltro ?? 30;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-pie-chart-fill me-2"></i>Grupos de produtos mais vendidos</h2>
            <p class="text-muted">Desempenho por categoria nos últimos <strong>@diasAtuais dias</strong>.</p>
        </div>

        <div class="btn-group shadow-sm">
            <a href="/Relatorios/GruposMaisVendidos?dias=7" class="btn btn-outline-primary @(diasAtuais == 7 ? "active" : "")">7 Dias</a>
            <a href="/Relatorios/GruposMaisVendidos?dias=30" class="btn btn-outline-primary @(diasAtuais == 30 ? "active" : "")">30 Dias</a>
            <a href="/Relatorios/GruposMaisVendidos?dias=90" class="btn btn-outline-primary @(diasAtuais == 90 ? "active" : "")">90 Dias</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="text-center" style="width: 80px;">#</th>
                        <th>Grupo / Categoria</th>
                        <th class="text-center">Qtd. Itens Vendidos</th>
                        <th class="text-end pe-4">Faturamento do Grupo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int rank = 1;
                        foreach (var grupo in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-secondary">@rank °</td>

                                <td class="fw-bold fs-5 text-dark">
                                    @grupo.NomeGrupo
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-white text-dark border fs-6">
                                        @grupo.QuantidadeTotal
                                    </span>
                                </td>

                                <td class="text-end pe-4 text-success fw-bold">
                                    @grupo.ValorTotal.ToString("C2")
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Nenhum dado encontrado neste período.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>