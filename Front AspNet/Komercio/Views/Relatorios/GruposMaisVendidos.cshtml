@using Komercio.Models.ViewModels
@model List<GruposTopViewModel>

@{
    ViewData["Title"] = "Grupos Mais Vendidos";
    int diasAtuais = ViewBag.DiasFiltro ?? 30;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-0 text-dark fw-bold">
                <i class="bi bi-pie-chart-fill me-2 text-primary"></i>Grupos Mais Vendidos
            </h2>
            <p class="text-muted small mb-0">Desempenho por categoria nos últimos <strong>@diasAtuais dias</strong>.</p>
        </div>
        <a asp-action="Index" asp-controller="Relatorios" class="btn btn-outline-secondary shadow-sm px-3">
            <i class="bi bi-arrow-left-circle me-2"></i>Voltar
        </a>
    </div>

    <div class="card bg-light mb-4 shadow-sm border-0">
        <div class="card-body d-flex align-items-center justify-content-between py-2">
            <span class="fw-bold text-secondary small text-uppercase">Filtrar período:</span>
            <div class="btn-group shadow-sm">
                <a href="/Relatorios/GruposMaisVendidos?dias=7"
                   class="btn btn-sm btn-outline-primary px-3 @(diasAtuais == 7 ? "active" : "")">7 Dias</a>
                <a href="/Relatorios/GruposMaisVendidos?dias=30"
                   class="btn btn-sm btn-outline-primary px-3 @(diasAtuais == 30 ? "active" : "")">30 Dias</a>
                <a href="/Relatorios/GruposMaisVendidos?dias=90"
                   class="btn btn-sm btn-outline-primary px-3 @(diasAtuais == 90 ? "active" : "")">90 Dias</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center ps-3" style="width: 100px;">RANKING</th>
                            <th>GRUPO / CATEGORIA</th>
                            <th class="text-center">QTD. ITENS VENDIDOS</th>
                            <th class="text-end pe-4">FATURAMENTO DO GRUPO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int contadorPosicao = 1;
                            foreach (var grupo in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        @if (contadorPosicao <= 3)
                                        {
                                            <span class="badge rounded-pill bg-warning text-dark shadow-sm p-2">
                                                <i class="bi bi-trophy-fill"></i> @(contadorPosicao)º
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted">@(contadorPosicao)º</span>
                                        }
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-bold fs-5 text-dark">@grupo.NomeGrupo</span>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge bg-light text-primary border border-primary fs-6 px-3">
                                            @grupo.QuantidadeTotal
                                        </span>
                                    </td>

                                    <td class="text-end pe-4 text-success fw-bold">
                                        <span style="font-size: 1.1rem;">@grupo.ValorTotal.ToString("C2")</span>
                                    </td>
                                </tr>
                                contadorPosicao++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-search fs-1 d-block mb-2 opacity-50"></i>
                                    Nenhum dado encontrado neste período.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>